[Unit]
Description=Mail yesterday's qmail-grafical-stats summary
After=mysqld.service

[Service]
Type=oneshot
User=qmaill
WorkingDirectory=/opt/qmail-grafical-stats
Environment=PYTHONPATH=/opt/qmail-grafical-stats
ExecStart=/usr/bin/python3 -m qmailstats.digest --config /etc/qmail-grafical-stats/config.ini
# Not NoNewPrivileges: qmail-inject hands the message to qmail-queue,
# which is setuid qmailq so it can write to the queue. With new
# privileges refused the setuid bit is ignored and every send fails
# with "qq trouble creating files in queue" -- and because these units
# only inject when there is something to say, they looked healthy on
# every quiet run and failed only when it mattered.
PrivateTmp=true
